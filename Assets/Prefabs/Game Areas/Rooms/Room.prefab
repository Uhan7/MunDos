    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.name
      value: Santi
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.character
      value: 
      objectReference: {fileID: -4258627021580615586, guid: 7c50abb68975940c9a305e1136732385, type: 3}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: playClosingAnimation
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<i>(\u201CMayor Fidel Lapuz\u201D. I heard he wasn\u2019t even present
        for half of his time as mayor of Sumpagita.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: <i>(Even in his own portrait, he looks like he wants to be somewhere
        else. Probably looking at an open window above him.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "\u201CNo journey is too treacherous nor a price too big for progress.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: <i>(Big words for someone not present for most of their term. If he
        truly did care, then why is Sumpagita still mostly rundown?)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: objectsToActivateAfter.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5790941259824625341, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: m_text
      value: 'Portrait 1: Mayor who loved travelling'
      objectReference: {fileID: 0}
