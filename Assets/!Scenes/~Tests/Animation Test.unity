      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_pare_guard_satisfied_mhm_3>Sure do! My tita\u2019s boss\u2019s
        nephew\u2019s girlfriend had a friend that was one of the victims! The story
        was so awful!"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: Or... is it the afternoon already? Anyways, have ya heard about the
        magical beasts that have been attacking people lately?
      objectReference: {fileID: 0}
