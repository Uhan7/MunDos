    character2: {fileID: 3825917228853779581, guid: 715adfd12147dc1479155bff01c07e0a, type: 3}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "<SFX_liezel_happy>Haha, I have not forgotten. As it happens, my sister left
      me a <b>manuscript</b> of her and Servillano\u2019s magic research <b><u>at
      our house</b></u>. "
    - <SFX_liezel_wondering>I want to take another look for the sake of this investigation,
      but it also contains information that might be of interest to you.
    - About an ore called <b><color=#cf4800>Salakab</color></b>.
