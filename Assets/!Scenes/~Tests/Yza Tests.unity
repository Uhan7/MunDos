  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a586b723e969462a991b263e7dd4cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: 21300000, guid: 96eb344a6948b4d6d9857fbd42887954, type: 3}
    character2: {fileID: -3929998360153519, guid: 7768e6cd5d1d84ba3b1a2c94654bef5d, type: 3}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - " I am...hoping for that as well. Se\xF1or Rommel, before you leave, may I
      have one more request?"
    - 'If you encounter Servillano or Lorena during your travels, please write to
      me and let me know of their well-being. '
    - The sudden silence of a once fruitful home is something one would not wish
      to experience. I quite miss their company.
