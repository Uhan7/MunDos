      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<shake><SFX_liezel_frustrated>Nonsense. I have no reason nor any motivation
        to betray someone like Servillano. He is my sister\u2019s husband even."
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
