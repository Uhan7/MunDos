      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: cool note typeshi, this state is p much needed cause the previous state's
        dialogue is too long lol
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(I wonder if I\u2019m the only one who heard that\u2026 It looks
        like it\u2019s been here for so long.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "<i>(The lid\u2019s so corroded that I can just pop it open. Let\u2019s
        see what\u2019s inside.)</i>"
      objectReference: {fileID: 0}
