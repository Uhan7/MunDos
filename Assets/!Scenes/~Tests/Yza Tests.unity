    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_liezel_thinking><i>(Should my comprehension not fail me, that
        phrase in the manuscript must lead me to acquiring something out of this
        tree. Although, I need to slice into its pitiful face\u2026)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<SFX_liezel_concerned><i>(I sure hope this tree is not cursed as I
        am not ready for a tree\u2019s tantrum...)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
