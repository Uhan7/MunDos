MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 403380096}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a69b3b713d3e9427d95225fc72ada10e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  descriptionText: 'Liezel needs to go to the Town Hall, so she can use the town
    bell as a distraction. If she interacts with the door, she notices that it is
    locked with a Padlock.

    

    When Liezel interacts with the Padlock for
    the first time, she mentions it to Santi, and Santi thinks to himself how he
    can help Liezel.

'
