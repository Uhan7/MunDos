      propertyPath: linksToOtherDialogue
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <SFX_liezel_concerned><i>(There is definitely something strange going
        on. Sumpagita used to be bustling with katalonans and albularyos.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(But now, these \u201Cmagic attacks\u201D have started influencing
        public opinion, especially among Disidensiya members. Is that a coincidence?
        I need to get to the bottom of this, fast.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: <i>(Magic has been part of our culture and history for so long... I
        cannot allow this to continue into the future I saw.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5994212485817288540, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: m_Name
      value: L1-DZ4
      objectReference: {fileID: 0}
