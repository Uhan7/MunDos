      value: 
      objectReference: {fileID: -2273764402948009021, guid: a258177e3ef6c1142819ad5a36074c40, type: 3}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.soundToPlay
      value: 
      objectReference: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <i>(This is one poetic bookmark. It even speaks of Giyala...)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: <i>(Did Servillano purposely write one of his poems on this bookmark
        to pass time and this was only the bookmark that my sister had access to
        at the time?)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "<i>(... Or did my sister tear off a part of Servillano\u2019s poems?)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: <i>(Actually, no, it is highly unlikely for her to mess with him like
        that. She would rather use a string as a bookmark.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: objectsToActivateAfter.Array.size
      value: 1
      objectReference: {fileID: 0}
