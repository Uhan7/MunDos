      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_liezel_thinking><i>(If he can sense it, then he may be able to
        handle it with no difficulty nor harm\u2026 I am not certain that he knows
        how to, but salakab should benefit him in his journey from here on out.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
