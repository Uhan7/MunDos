    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_santi_shocked_questioning><i>(It\u2019s\u2026 a box? So it was
        coming from this.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(It looks like it\u2019s been here for a long time, the lid\u2019s
        so corroded that I can just pop it open. Let\u2019s see what\u2019s inside.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
