      propertyPath: playClosingAnimation
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: mainCharacterIsSpeaking
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "I\u2019ve spent many a decade searching for rare and hidden antiques.
        I dare say there is <i>no secret I cannot uncover!</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: <SFX_antiquarian_thinking>Sumpagita Forest used to be a hubbub full
        of soldiers and civilians alike. Not that anyone ever decided to settle here.
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: After all, Sumpagita, the town itself, is right nearby. Not to mention
        the war.
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "Still, you can find the odd treasure here and there\u2014bits and bobs
        from people passing through."
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: "If you\u2019re lucky, you may even find something older than the war."
      objectReference: {fileID: 0}
    - target: {fileID: 9032494519262131888, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: id
      value: 9e3c71da-f1e3-4d35-943c-39018bc8d9bd
      objectReference: {fileID: 0}
