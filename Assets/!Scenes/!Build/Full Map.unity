      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <i>(There truly is one here. These emblems are used to distinguish Disidensiya
        members.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: <i>(I have one myself, not that I remember where I last put it. I typically
        do not need it for the DG members in this area to recognize me.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: <i>(I should be able to use this to <b>distract the guards in front
        of the main building</b>.)</i>
      objectReference: {fileID: 0}
