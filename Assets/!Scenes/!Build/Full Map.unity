    name: Anika
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - 'What!? No!? '
    - "Even the great Se\xF1or Rommel did not rob anyone! <i>Except for Se\xF1or
      Servillano\u2019s trust... and their circle of leaders, but... </i>"
    - "No, I\u2019m just someone who wants people to learn about the great Se\xF1or
      Rommel in full authenticity!"
