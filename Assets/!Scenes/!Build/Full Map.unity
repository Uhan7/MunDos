    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: nextDialogue
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: dialogue.name
      value: Tour Guide
      objectReference: {fileID: 0}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: dialogue.character
      value: 
      objectReference: {fileID: -1077248894956463413, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: dialogue.character2
      value: 
      objectReference: {fileID: -6412774339020565012, guid: ee489ea9654334b49bebfbb6cef6f549, type: 3}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: linksToOtherDialogue
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: playClosingAnimation
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: mainCharacterIsSpeaking
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "The first to commemorate Rommel Lapuz was Governor Luna Lapuz, the
        one who had Rommel\u2019s tomb built and had a <u>hobby of sports shooting</u>."
      objectReference: {fileID: 0}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "The second was Senator Mahalia Lapuz who first established the museum...
        Yes, the \u201CSenator Cockfighter\u201D with the <u>chicken ring</u>."
      objectReference: {fileID: 0}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "The third was Mayor Fidel Lapuz who erected Rommel\u2019s statue and
        <u>loved to travel</u>."
      objectReference: {fileID: 0}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "The last was Sir Teodoro Lapuz, the one that ensured Rommel\u2019s
        name survived in educational and historical books and had a <u>penchant for
        gold</u>."
      objectReference: {fileID: 0}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: The family has quite a reputation, huh?
      objectReference: {fileID: 0}
    - target: {fileID: 9197020353560056044, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[5]'
      value: The family has quite a reputation, huh?
      objectReference: {fileID: 0}
