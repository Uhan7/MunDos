      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <SFX_liezel_wondering>The Congregation convinced Rommel to help them
        destroy the reputation of magic users. Rommel agreed to do so because he
        wanted to crush the Kapisanan.
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<SFX_liezel_concerned>But... It is more than that. He fears that Giyala
        will be crushed if he does not take action. To unite all Giyalans under the
        Disidensiya\u2019s cause... "
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "Seems he shares Servillano\u2019s idealism after all. "
      objectReference: {fileID: 0}
    - target: {fileID: 9032494519262131888, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: id
      value: 8765b6a6-038f-47b9-b7cb-9b325cf254f6
      objectReference: {fileID: 0}
