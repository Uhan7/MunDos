  dialogue:
    character: {fileID: -1077248894956463413, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    character2: {fileID: 3956817798168410636, guid: 7cb4d603f9531c24a9be431c18097dfe, type: 3}
    name: Anika
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "<SFX_anika_laugh>There, good! Yes, I know about the Disidensya leaders from
      even before the war, especially the great Se\xF1or Rommel!"
    - "<SFX_anika_concerned>I mean she\u2019s not wrong at all, but she didn\u2019t
      even tell the story about our great Se\xF1or Rommel\u2014only his descendants!
      <i>People these days...</i>\r"
