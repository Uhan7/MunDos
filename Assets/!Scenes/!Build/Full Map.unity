    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_liezel_wondering>A dagger with a sturdy form and an interesting
        design. It would be a shame to dull a blade like this, especially if I\u2019ll
        need it later."
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "There seems to be another symbol on this dagger, I\u2019ll draw it
        for you, Santi."
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
