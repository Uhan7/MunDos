      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<i>(Quite the statement, but it seems like it was not for show. There
        are quite a few big names in this crowd\u2014even that <b>Celebrity</b> that
        has been all over the press lately.) </i>\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "... You know what? It should have been rang, \r\nif only to tell people
        about that health hazard of a loaf. "
      objectReference: {fileID: 0}
