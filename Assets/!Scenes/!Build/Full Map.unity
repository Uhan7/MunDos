  dialogue:
    character: {fileID: 584213497, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    character2: {fileID: 0}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "<i>(... Was the maid\u2019s bread really so bad to warrant such a reaction...?
      I was expecting a little displeasure, at best.) </i>"
    - "<i>(It made that Celebrity leave in a hurry. She must be embarrassed\u2014she
      was supposed to be endorsing the product, after all.)</i>"
