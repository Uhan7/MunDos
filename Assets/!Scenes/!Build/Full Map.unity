    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.character
      value: 
      objectReference: {fileID: 1485388185277433987, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.character2
      value: 
      objectReference: {fileID: -800736819685987722, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
