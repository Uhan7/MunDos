  dialogue:
    character: {fileID: 3606627201376690057, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    character2: {fileID: -6692246431099723313, guid: 65000ea5f4823244181ad550091ee21c, type: 3}
    name: Maid
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "A-Ah! Looks like the Se\xF1or has left already... You are free to stay here,
      madame!"
    - 'We sincerely apologize for the smell... '
    - "Se\xF1or Rommel has been using the fireplace to burn things lately, and we
      haven't completely aired out the room yet, hehe..."
    - 'A-Anyway, I will be at the foyer! Please feel free to come to me if you have
      any requests, madame! '
