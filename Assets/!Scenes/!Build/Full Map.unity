    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<i>(A book? It looks pretty fancy, what\u2019s it doing in a place
        like this?)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(Hm\u2026 Unregulated books are hard to get these days. I should
        take a look.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "<i>(... What? The pages are empty. That\u2019s kind of disappointing.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: '<i>(But why does it feel like this book is special somehow?)</i>

'
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
