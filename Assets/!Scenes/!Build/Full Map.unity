      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_santi_wondering><i>(It\u2019s this again. I remember seeing this
        years ago. Even then, people though it was \"<b>time</b> to change\".)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: <i>(That's funny. <u>The order of the posters and graffiti on this wall
        almost feels deliberate</u>, like a peek into Giyala's history.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "<i>(I guess some things just won\u2019t change in this place.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5865463505797322737, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
