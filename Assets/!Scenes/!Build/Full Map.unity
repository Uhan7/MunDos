      propertyPath: mainCharacterIsSpeaking
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 2e6185c7e5dbb4c4989dcb38e25cdcb4, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 2e6185c7e5dbb4c4989dcb38e25cdcb4, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: 'Remain vigilant. '
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 2e6185c7e5dbb4c4989dcb38e25cdcb4, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: Until the meeting tomorrow night is over, you must not leave your posts
        unless there is a civilian that requires your assistance.
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 2e6185c7e5dbb4c4989dcb38e25cdcb4, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: Should any possible interference occur in the remaining hours and no
        one is available, which I hope will not be the case, I myself will take over.
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 2e6185c7e5dbb4c4989dcb38e25cdcb4, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "The times have changed. Giyala no longer holds stability on its own,
        unlike before. We must gather as much power as we can get. Our competence
        will keep us grounded.\r"
      objectReference: {fileID: 0}
