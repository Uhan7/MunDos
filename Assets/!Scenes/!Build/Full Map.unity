    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<i>(The Block Press Manual., printed on April 8 19XX. Is this for the
        printing press? It has a curvy logo stamped on it. Let's see\u2026)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(It looks to be signed by someone named \u201C<b>Rommel</b>\u201D.
        \u201CTo fight injustice, first we must write it.\u201D)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5790941259824625341, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
