    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.name
      value: Liezel
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.character
      value: 
      objectReference: {fileID: 1011711402038377536, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.textSpeed
      value: 0.022
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.soundToPlay
      value: 
      objectReference: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: linksToOtherDialogue
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: playClosingAnimation
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: It's a series of strange phrases...
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "\u201CResiding in a familiar abode is an unmoving still. A maiden to
        her dreams, bearing a vessel- browned by kiln.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "\u201CBeneath the spot great distress once was, who flew now having
        learned of you.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "\u201CA sharp and hardened steel blade well made. Its craftsmanship
        holds against the test of time.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: "\u201CLittered are the lies, read by the mass. Rewritten are their
        minds of magic.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[5]'
      value: "\u201CSlice into the wailing eyes, its bark's no more than a silent
        cry.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[6]'
      value: "And, \u201CPlace the gem center of what you seek, a message then unraveled
        for you to read.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[7]'
      value: What could they mean?
      objectReference: {fileID: 0}
