    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: soundsToPlayBefore.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: ...
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: ' I think I might have found the exact pages... '
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: " \u201CThose bastards will not respond to reason. My only hope of being
        understood lies with Servillano\u2014\""
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: '"If I can convince him then perhaps the others will follow along like
        sheep. But Servillano has always been a man steadfast with his beliefs. "'
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: " \u201CThis is something I once admired him for, but now I fear it
        will get in our way. I have spoken to the wretched Congregation. They sent
        a spy into our ranks, but I found them quickly. However, they had an enticing
        offer.\u201D "
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'soundsToPlayBefore.Array.data[0]'
      value: 
      objectReference: {fileID: 8300000, guid: d4d19057ca7414b93b9d2d40523aa6cf, type: 3}
    - target: {fileID: 9032494519262131888, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: id
      value: 6e96a760-2684-4216-861d-15acaf93ffa3
      objectReference: {fileID: 0}
