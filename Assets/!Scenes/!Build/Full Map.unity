  dialogue:
    character: {fileID: -3387389256237283611, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    character2: {fileID: 469124848644572142, guid: ae0d97eff7309c74ba269c7bf7814d3a, type: 3}
    name: Tour Guide
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "<SFX_tour_guide_chuckle>Well, you\u2019re the only person I\u2019ve gotten
      to tell all this in a while. It would be a shame if I spent the day telling
      you lies."
    - "Besides, with all the things Sumpagita is going through lately... I\u2019m
      just not in the mood to butter up all these people. "
    - "Anyways, that\u2019s that story done. Is there anything else you want to know?"
