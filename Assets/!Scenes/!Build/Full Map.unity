    character2: {fileID: -766158179369566821, guid: 43023e1e55b1c4b969570c5c23126194, type: 3}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - <i>(There is only one outpost like that around Sumpagita. I suppose it is to
      be expected that my book remained in this area. )</i>
    - "<i>(I should head <b>West</b>. The Disidensiya\u2019s <b>Sumpagita Outpost</b>
      is over there, <b>just past the forest</b>.)</i>"
