  dialogue:
    character: {fileID: 1011711402038377536, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    character2: {fileID: -1329520365918380838, guid: 18b983b6af9e3e840bf005f9f12452ae, type: 3}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "Excuse my sudden interference, but I have come here for matters that involve
      my line of work. \r\n"
    - I would turn to Servillano for this, but he is not available as of the moment.
      Perhaps you have the knowledge that I could have gotten from him?
