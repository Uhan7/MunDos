      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_liezel_questioning>\u201CS x L\u201D?"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(Written on <u>Valentine\u2019s Day</u>, of course. Whoever wrote
        these must have been in love. Haha, could it have been <b>Servillano</b>
        and Lorena\u2019s doing?)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: <i>(... Though this engraving looks rather old, have they been together
        for so long?)</i>
      objectReference: {fileID: 0}
