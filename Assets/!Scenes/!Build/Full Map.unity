MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1752184947}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a586b723e969462a991b263e7dd4cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: -3387389256237283611, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    character2: {fileID: -1293936391025474623, guid: 4551b9b0ca3f36b498cfea661e9dc542, type: 3}
    name: Anika
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "This statue? You don\u2019t know about our great Se\xF1or Rommel? How come?
      He literally saved Giyala. Even Se\xF1or Servillano couldn\u2019t match his
      wits. \r\n"
