    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.name
      value: Santi
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.character
      value: 
      objectReference: {fileID: -860332198591883356, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.character2
      value: 
      objectReference: {fileID: 3898147896683463673, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.soundToPlay
      value: 
      objectReference: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: linksToOtherDialogue
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: playClosingAnimation
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: " \u201CWe may be able to crush the Kapisanan for good if we destroy
        the reputation of their leader, and thus the foundation of their very belief.\""
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "\"One less enemy striving for rule of Giyala means we can all be united
        against the common enemy.\u201D "
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: " \u201CThe Congregation believes they will benefit from this, but I
        have true faith in the will of our people, if not in the bureaucratic nonsense
        of the fools I am surrounded by.\u201D "
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: " \u201CServillano must see that the time to take action has long passed.
        I do not fear his rejection, but that I may truly be the only one left in
        the Disidensiya who has the audacity to act.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 9032494519262131888, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: id
      value: 8b3b5fc7-6461-46be-8185-1724189fb743
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
