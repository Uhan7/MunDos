  dialogue:
    character: {fileID: -4833260855376239280, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    character2: {fileID: 6555668280622217898, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "... That novel painting, perhaps? The phrase must be used for something relating
      to Se\xF1or Rommel."
    - "Santi, if you are able, <b>see if that phrase would be of use in the museum</b>.
      Meanwhile, I have to find out if this connects to anything in Se\xF1or Rommel\u2019s
      house, which I hope it is."
