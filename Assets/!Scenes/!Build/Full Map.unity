  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: 6555668280622217898, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    character2: {fileID: 0}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - <i>(A sack? If it is attached to the other components of the town bell, then
      it may be used to ring the bell. It is currently empty since there are no reasons
      to use this bell as of the moment.)</i>
    - <i>(According to what I have read and heard before, there is a specific process
      to follow to ring the town bell. Unfortunately, I only know how to accomplish
      this and do not have what is needed for it.)</i>
    - <i>(I need to gather what is needed before I can use it.)</i>
