      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <SFX_santi_questioning><i>(Wow! That is massive! What is this thing?)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(Letter blocks? Is this a printing press? I haven\u2019t seen these
        things before. Especially one so close.)</i> "
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: <i>(I wonder if the people in Sumpagita know about this? Maybe I could
        ask the museum to restore it once our problem is over.)</i>
      objectReference: {fileID: 0}
