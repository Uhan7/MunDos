      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: <SFX_antiquarian_thinking><b>Orchid sap</b> will <u>raise pH and lower
        salinity</u>, while <b>hibiscus sap</b> will raise <u>salinity and lower
        pH</u>. Also, <b>hibiscus petals</b> can be used to <u>neutralize the effects
        of both</u>, giving you a fresh start.
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
