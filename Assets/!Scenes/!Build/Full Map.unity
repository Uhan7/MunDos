  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a586b723e969462a991b263e7dd4cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: 21300000, guid: 96eb344a6948b4d6d9857fbd42887954, type: 3}
    character2: {fileID: -3929998360153519, guid: 7768e6cd5d1d84ba3b1a2c94654bef5d, type: 3}
    name: Rommel
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - 'Magic attacks? You turn to your leaders for occurrences involving magic? '
    - "If this magic can somehow do more benefit than harm, then the kapisanan would
      not have opposed the Disidensya years ago. \r\n"
    - "Proof of its harm is apparent in Servillano\u2019s shift in judgement. It
      is untimely. Unreasonable."
    - "What these rocks can do or have done are out of the Disidensya\u2019s hands.
      The kapisanan is not one to trust either. It is something that you or the likes
      of your dear sister would never understand.\r\n"
  startOnEnable: 1
  startFromTrigger: 0
  isSign: 0
  willFocus: 1
  willHideUI: 0
