  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: 5513359351382692184, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    character2: {fileID: -6412774339020565012, guid: ee489ea9654334b49bebfbb6cef6f549, type: 3}
    name: Tour Guide
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - 'Haha, <b><i>Senator Mahalia Lapuz</i></b> got into a real big controversy
      because she was cracking down on illegal gambling rings... '
    - Only to get exposed for hosting chicken fighting gambling parties.
    - "Still, I can\u2019t disparage her reputation too much, she was the one who
      first had the museum built, after all."
