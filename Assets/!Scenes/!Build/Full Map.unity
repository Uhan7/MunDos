  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: -3929998360153519, guid: 7768e6cd5d1d84ba3b1a2c94654bef5d, type: 3}
    character2: {fileID: 21300000, guid: 96eb344a6948b4d6d9857fbd42887954, type: 3}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "Excuse my sudden interference, but I have come here for matters that involve
      my line of work. \r\n"
    - I would turn to Servillano for this, but he is not available as of the moment.
      Perhaps you have the knowledge that I could have gotten from him?
  startOnEnable: 1
  startFromTrigger: 0
  isSign: 0
  willFocus: 1
