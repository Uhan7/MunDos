  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2072385360}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a586b723e969462a991b263e7dd4cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: 21300000, guid: dc99f5b83dc944550839ba63fa34b687, type: 3}
    character2: {fileID: -5562468424120001742, guid: ce4d04f01b4184171825197de710c760, type: 3}
    name: Tour Guide
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "Well, you\u2019re the only person I\u2019ve gotten to tell all this in a while.
      It would be a shame if I spent the day telling you lies.\r\n"
    - "Besides, with all the things Sumpagita is going through lately... I\u2019m
      just not in the mood to butter up all these people. "
    - "Anyways, that\u2019s that story done. Is there anything else you want to know?\r\n"
