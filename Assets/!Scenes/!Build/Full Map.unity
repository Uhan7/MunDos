    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <i>(This Filipina resembles Lorena. Perhaps she thought this painting
        would be enough to remind me of her presence even when we are apart.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: <i>(Fair reason. We were almost inseparable before she was married.
        But now that we are in the same house again along with her husband, she has
        nothing to worry about.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: <i>(Aside from that, this painting has had this <b>small symbol</b>
        written on for a while... I wonder if she did that for an experiment of some
        sort?)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5790941259824625341, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: m_text
