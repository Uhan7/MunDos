    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_santi_wondering>No one\u2019s been keeping the welcome sign up
        to date anymore. There\u2019s definitely more people than this in Sumpagita
        now."
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "The only people who move here are history-obsessed weirdos and people
        who can\u2019t afford the capital, though."
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "<SFX_santi_thinking>I wonder what the <b>difference</b> is between
        the population of Sumpagita in Liezel\u2019s time and mine. It sounds like
        her Giyala is still in good shape\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 5865463505797322737, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
