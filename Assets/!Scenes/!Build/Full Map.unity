    - target: {fileID: 8439490232393766861, guid: a27c50b6b538a42eaa4899948f125870, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: 'Alright, here we are!

'
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: a27c50b6b538a42eaa4899948f125870, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "The museum is dedicated to keeping records of the <i>Lapuz Family</i>,
        who have contributed greatly to Giyala\u2019s growth ever since the end of
        the Kulonium War."
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: a27c50b6b538a42eaa4899948f125870, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: He was the leader of the Disidensiyang Giyala, who were local heroes
        who protected Giyalans during the war.
      objectReference: {fileID: 0}
