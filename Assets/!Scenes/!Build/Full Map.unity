    character2: {fileID: 0}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - <i>(There. The bell is ringing correctly. It should be able to capture the
      attention of many now.)</i>
    - "<i>(Once they come, I must take the small chance to enter Rommel\u2019s House
      unguarded.)</i>"
    - <i>(This interference may gain me dishonor and judgement, but no amount of
      that would compare to the respect that Giyala needs.)</i>
    - "<i>(I sincerely hope that if not most, then one of our leaders will think
      this through. Servillano\u2026 you may be our last hope.)</i>"
