      propertyPath: mainCharacterIsSpeaking
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "No no. I also sensed something weird with Master Rommel. I don\u2019t
        mean to be malicious against him, but every night, as I\u2019m about to end
        my shift... "
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "I keep hearing murmurs in Rommel\u2019s office."
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: 'Just a few nights ago, the door was slightly open. I was really curious
        and wanted to take a peak. '
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: Master Rommel was writing furiously in a journal. I swear he looked
        like a different person.
      objectReference: {fileID: 0}
    - target: {fileID: 9032494519262131888, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: id
      value: 4b5cb048-bde6-480c-a275-a6296f2a6887
