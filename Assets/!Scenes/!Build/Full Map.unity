      objectReference: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: linksToOtherDialogue
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<start_dim><i>(This is it. I must steel myself. Rommel\u2019s deeds
        have to be made clear to the rest of the Disidensiya. I can\u2019t let Santi\u2019s
        efforts go to waste either.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(Regardless of his intentions, this is not the way the Disidensiyang
        Giyala wanted to fight. Playing along with the enemy\u2026 Tricking our own
        people\u2026 What a farce.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: <i>(This ends now.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: <SFX_liezel_shock_gasp>(...!)
      objectReference: {fileID: 0}
