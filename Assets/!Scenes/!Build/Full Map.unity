      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_distressed_woman_disgust>I don\u2019t want anything to do with
        you <i>magic users</i>! I bet it was one of <i>you</i> that summoned that
        disgusting monster!"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: 'G-Get away from me!

'
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: Ohh- It was a horrible thing!<dim>It looked like an animal turned inside
        out, crawling on all-fours...! It was too fast for me to outrun!</dim>
      objectReference: {fileID: 0}
    - target: {fileID: 9032494519262131888, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
