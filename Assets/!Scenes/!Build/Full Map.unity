      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <SFX_liezel_wondering>That is correct. I suppose that may be part of
        the reason Servillano has been struggling so much.
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: 'Truly? That is a shame. Ate Lorena would be worried sick if she saw
        him. '
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
