      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_santi_sigh><i>(Finally out of that weird forest. Never thought
        I\u2019d go so out of the way just to catch a break.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(Now\u2026 <b>That old outpost</b> I saw on the map should be around
        here somewhere\u2026)</i>"
      objectReference: {fileID: 0}
