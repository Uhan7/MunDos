      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <SFX_liezel_wondering><i>(Hm. The gem fits perfectly within the curvature
        of the symbol.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(Something definitely happened. Hopefully, no one noticed\u2026
        The manuscript should have more answers for me, I must get back to it.)/i>"
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
