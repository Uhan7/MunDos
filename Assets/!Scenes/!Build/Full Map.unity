      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: How did things end up this way?
      objectReference: {fileID: 0}
    - target: {fileID: 3392612049195102056, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "I \r  thought...Ugh. "
      objectReference: {fileID: 0}
    - target: {fileID: 3392612049195102056, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "You know, Se\xF1or Rommel always walked past my bakery, but never thought
        of trying my bread. Maybe that was for the better... "
      objectReference: {fileID: 0}
    - target: {fileID: 3392612049195102056, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
