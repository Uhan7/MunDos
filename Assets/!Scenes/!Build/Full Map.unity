  dialogue:
    character: {fileID: 216368989601859519, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    character2: {fileID: -1329520365918380838, guid: 18b983b6af9e3e840bf005f9f12452ae, type: 3}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "Apologies for the misunderstanding, Se\xF1or Rommel. My name is Liezel, Servillano\u2019s
      sister-in-law. I suppose he has mentioned my name in passing?"
