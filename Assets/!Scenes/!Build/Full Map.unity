      value: 
      objectReference: {fileID: 1485388185277433987, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: dialogue.soundToPlay
      value: 
      objectReference: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: linksToOtherDialogue
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: playClosingAnimation
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<i>(Hey, isn\u2019t this the Rommel guy? Hm. Who is he with?) </i>"
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: <i>(Anyway, this looks like an antique though... Weird. Why is it just
        lying around in town?) </i>
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: <i>(Maybe the tour guide knows something about this?) </i>
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "<i>(Wait, wait, wait. No, that\u2019s a bad idea. She might take this
        from me if I ask her. She\u2019s still a museum employee.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: <i>(Maybe that Anika person can tell me about this!) </i>
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: objectsToActivateAfter.Array.size
      value: 0
      objectReference: {fileID: 0}
