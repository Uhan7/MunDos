  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: 1011711402038377536, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    character2: {fileID: -1329520365918380838, guid: 18b983b6af9e3e840bf005f9f12452ae, type: 3}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "I am...hoping for that as well. Se\xF1or Rommel, before you leave, may I have
      one more request?"
    - 'If you encounter Servillano or Lorena during your travels, please write to
      me and let me know of their well-being. '
    - The sudden silence of a once fruitful home is something one would not wish
      to experience. I quite miss their company.
