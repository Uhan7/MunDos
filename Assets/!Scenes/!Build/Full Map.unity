    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <SFX_liezel_frustrated>Alright, fine! The town is nearby, at least get
        yourself to safety if you can.
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: <i>(At least she did not look too injured. This situation is getting
        out of hand. I should hurry to the outpost.)</i>
      objectReference: {fileID: 0}
