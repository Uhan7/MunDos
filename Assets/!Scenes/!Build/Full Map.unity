  m_Script: {fileID: 11500000, guid: 1a586b723e969462a991b263e7dd4cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: 21300000, guid: dc99f5b83dc944550839ba63fa34b687, type: 3}
    character2: {fileID: -5562468424120001742, guid: ce4d04f01b4184171825197de710c760, type: 3}
    name: Tour Guide
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "A lot of things had to be rebuilt after the war\u2014the museum used to be
      the Lapuz Family Manor, but it was heavily damaged."
    - 'Senator Lapuz decided mid-renovations to have it turned into a museum... Likely
      as a publicity stunt to turn her reputation around. And it worked, funnily
      enough.

'
    - "... Well, it\u2019s not funny if you really think about it, but at least I
      have a job.\r\n"
    - 'The third was a former mayor of Sumpagita, <b><i>Mayor Fidel Lapuz</i></b>,
      who was known for travelling around the world, gathering information that he
      could bring back for the sake of improving Sumpagita!

'
  startOnEnable: 1
  startFromTrigger: 0
  isSign: 0
  willFocus: 1
  willHideUI: 0
