    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: 'Ew, this is disgusting! I cannot believe I waited all day for such
        garbage. '
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: You can count on me never returning to this establishment!
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: 'For a business like this to stoop to such harsh and untrue marketing... '
      objectReference: {fileID: 0}
    - target: {fileID: 4746459191129394785, guid: e03ab5007ef7b460e9e1351d398246ac, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[5]'
      value: 'Hmph, nobody can be trusted these days. '
      objectReference: {fileID: 0}
