      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_santi_questioning><i>(What is this thing? It looks so rusty and
        dirty\u2026 How long has it been here?)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(Actually this looks familiar\u2026 Oh, it\u2019s an <b>emblem</b>
        of Disidensiya! But why would someone bury it?)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "<i>(Doesn\u2019t matter, maybe it\u2019s still there in Liezel\u2019s
        time?)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "Liezel, I found this emblem buried near the outpost. Maybe it\u2019s
        there in your time?"
      objectReference: {fileID: 0}
    - target: {fileID: 5790941259824625341, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: m_text
