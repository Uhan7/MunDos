MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 527519533}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a586b723e969462a991b263e7dd4cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: -3921962357827113515, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    character2: {fileID: -860332198591883356, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "<SFX_liezel_wondering><i>(They seem suspicious of magic... So is it true that
      it had a hand in Giyala\u2019s fall? I must learn more, at all costs.)</i>"
    - Please give me a chance. All I need is information. I am not sure what occurred
      between my time and yours, and why magic has become so taboo for you.
    - <SFX_liezel_concerned><dim>In my time, rumors of magic being evil and mysterious
      monster attacks have just begun circulating.
    - But magic is not a tool for harm, nor is it unknowable. If you help me, I can
      teach you how magic can be used for good.
  startOnEnable: 1
  startFromTrigger: 0
