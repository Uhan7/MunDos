    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: It has worked out for us so far, has it not?
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: The maid mentioned Rommel keeping a red journal. Could it be inside
        this safe?
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "I never thought I would become the type to look in others\u2019 journals...
        But our cause is just. "
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "The lock seems to be arrows pointing in the cardinal directions instead
        of numbers. \r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: Looks like Rommel was similar to Servillano in regard to how they like
        to lock up their things.
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[5]'
      value: Santi, let us look for clues again.
      objectReference: {fileID: 0}
    - target: {fileID: 9032494519262131888, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: id
      value: 40f32b2f-0a15-4af8-a3f4-68ff69e960a6
      objectReference: {fileID: 0}
