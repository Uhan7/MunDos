      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "<SFX_liezel_thinking><i>There\u2019s a <b>strange symbol marked into
        the blade</b>.</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: <i>Unfortunately, I cannot bring this outside.</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: <i>A spade is one thing, but if the guards saw me trying to sneak an
        axe out, I do not think it would go well.</i>
      objectReference: {fileID: 0}
