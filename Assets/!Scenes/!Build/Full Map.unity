  m_Script: {fileID: 11500000, guid: 1a586b723e969462a991b263e7dd4cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: -113776002870788311, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    character2: {fileID: -1688287168362419083, guid: 18b983b6af9e3e840bf005f9f12452ae, type: 3}
    name: Rommel
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "That is too much for your standing. I am talking about a <i>private</i> meeting\u2014more
      intimate than what we are having as of the moment. "
    - "Only the Disidensya leaders are participating as their opinions and plans
      about the current situation of our country contribute to my proposition. \r\n"
    - Their approval is most important to new possible arrangements.
