      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <SFX_pare_guard_satisfied_1>Good afternoon again, miss!
      objectReference: {fileID: 0}
    - target: {fileID: 3392612049195102056, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "Ya\u2019 know, I just had this thought. Between the DG and the Kapisanan,
        why don\u2019t we get along? We\u2019re working for the same goal."
      objectReference: {fileID: 0}
    - target: {fileID: 3392612049195102056, guid: b344d6e93f1d24655a8a05fd4f9c94ec, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "<SFX_pare_guard_sigh>It\u2019s quite a waste of time to be fighting
        one another."
      objectReference: {fileID: 0}
