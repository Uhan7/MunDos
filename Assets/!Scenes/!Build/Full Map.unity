  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: 1011711402038377536, guid: 5d7a500b15e65d3499df83ac5f56ef87, type: 3}
    character2: {fileID: 0}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - <i>(I assume that this is the rope to be pulled for the bell to ring. Currently,
      it seems to not be in the right condition to be rung.)</i>
    - <i>(One purpose of a rope is to be pulled, such as in this case, so there should
      probably be some weight to pull first. Then, pulling it should be able to make
      the bell sound like normal.)</i>
