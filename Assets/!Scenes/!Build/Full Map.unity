      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <SFX_liezel_wondering>Yes, I believe that would be more efficient. These
        will definitely lead us to where we need to be. Let me know if you need assistance
        with the fragment. Else, follow your instincts.
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
