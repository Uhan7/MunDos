  dialogue:
    character: {fileID: 800374798371294830, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    character2: {fileID: -8301143672777514151, guid: 4551b9b0ca3f36b498cfea661e9dc542, type: 3}
    name: Santi
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "I\u2019ve heard of their leadership going hand in hand from Liez- I- I mean
