    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "<SFX_maid_chuckle>A-Ah! Looks like the Se\xF1or has left already... You are
      free to stay here, madame!"
    - 'We sincerely apologize for the smell... '
    - "Se\xF1or Rommel has been using the fireplace to burn things lately, and we
      haven't completely aired out the room yet, hehe..."
    - '<SFX_maid_affirmative>A-Anyway, I will be at the foyer! Please feel free to
      come to me if you have any requests, madame! '
