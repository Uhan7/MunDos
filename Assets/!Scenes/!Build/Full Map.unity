      value: Santi
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.character
      value: 
      objectReference: {fileID: -5562468424120001742, guid: ce4d04f01b4184171825197de710c760, type: 3}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: playClosingAnimation
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "No one\u2019s been keeping the welcome sign up to date anymore. There\u2019s
        definitely more people than this in Giyala now.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "The only people who move here are history-obsessed weirdos and people
        who can\u2019t afford the capital, though. \r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "I wonder what the <b>difference</b> is between the population of Giyala
        in Liezel\u2019s time and mine. It sounds like her Giyala is still in good
        shape\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 6422280081895110284, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: id
      value: 8e0787e3-1dd1-4183-9fa7-78ec42cfdd9b
      objectReference: {fileID: 0}
    - target: {fileID: 7640102151652040996, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
