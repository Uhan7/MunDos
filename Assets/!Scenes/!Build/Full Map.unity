      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <SFX_santi_concerned><i>(Oh wow, that looks badly beaten up.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<SFX_santi_questioning><i>(Is this a label? \u2026 \u201CTo: <b>Servillano
        Solomon</b>\u201D? That name sounds familiar.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "<i>(It was delivered on <u>November 29, 19XX</u>. I wonder if there\u2019s
        anything left inside.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: <SFX_santi_thinking><i>(...)</i>
      objectReference: {fileID: 0}
