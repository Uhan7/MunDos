      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <SFX_liezel_thinking><i>(What is this? Is this supposed to be a dagger?
        Its shape even resembles that of a snake...)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(This is definitely not a regular object\u2014more so a weapon.
        Who ever thought about burying such a thing?)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
