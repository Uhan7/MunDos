    character: {fileID: -3387389256237283611, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    character2: {fileID: 469124848644572142, guid: ae0d97eff7309c74ba269c7bf7814d3a, type: 3}
    name: Tour Guide
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "<SFX_tour_guide_thinking>Well there\u2019s a world of difference between someone
      who led soldiers on the front lines to protect people and... politicians who
      grew up rich.\r"
    - "Anyways, let me finish the story. The last person was <b><i>Sir Teodoro Lapuz</i></b>,
      who became the head of the Department of Education, he\u2019s the reason Rommel\u2019s
      name and deeds have survived in textbooks."
