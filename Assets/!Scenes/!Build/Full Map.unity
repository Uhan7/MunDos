    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: soundsToPlayBefore.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: 'Date: 09/23/XXXX'
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: 'Staff: Jose Antonio Reynaldo

'
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: 'Time In: 08:04

        Time Out: 18:30

'
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "\u201CNot again\u2026 The sack has been emptied out! The boss will
        scold me again if I don\u2019t find the rocks by the time I clock out. Who
        steals rocks anyway?\u201D "
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: "\u201CSome teenagers thought it would be funny if the bell couldn\u2019t
        be rung. Don\u2019t they know how important it is that it remains operational?
        We should really stop allowing just anyone to enter the building. I\u2019m
        just going to lock these rocks away.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[5]'
      value: "\u201CThere, it\u2019s been locked away. Though, we should have this
        padlock replaced soon.\u201D\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: 'soundsToPlayBefore.Array.data[0]'
      value: 
      objectReference: {fileID: 8300000, guid: edf4ad070e4694b869d0748da36e5164, type: 3}
