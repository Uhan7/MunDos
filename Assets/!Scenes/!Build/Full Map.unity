  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: -1077248894956463413, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    character2: {fileID: 5453050337825942149, guid: 4551b9b0ca3f36b498cfea661e9dc542, type: 3}
    name: Anika
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "There, good! Yes, I know about the Disidensiya leaders from even before the
      war, especially the great Se\xF1or Rommel!"
    - "I mean she\u2019s not wrong at all, but she didn\u2019t even tell the story
      about our great Se\xF1or Rommel\u2014only his descendants! <i>People these
      days...</i>\r"
