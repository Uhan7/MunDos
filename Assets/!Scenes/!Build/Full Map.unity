  m_Script: {fileID: 11500000, guid: 1a586b723e969462a991b263e7dd4cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: 21300000, guid: 96eb344a6948b4d6d9857fbd42887954, type: 3}
    character2: {fileID: -3929998360153519, guid: 7768e6cd5d1d84ba3b1a2c94654bef5d, type: 3}
    name: Rommel
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - 'My limited time is being wasted by all this unnecessary talk.

'
    - ' I must leave you to your own agenda, although I would have to decline your
      requests about the meeting. You can be writing something much easier for the
      masses to absorb than what our meeting can offer. '
    - 'As a compromise, I am allowing you to get any information that you need from
      my house. Explore as you wish. My staff is well-rounded as I have prepared
      them to be.

'
    - I would only remind you to know your boundaries. You must know what is appropriate
      and what is not, I assume?
