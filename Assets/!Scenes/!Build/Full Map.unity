  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a586b723e969462a991b263e7dd4cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: -1077248894956463413, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    character2: {fileID: 469124848644572142, guid: ae0d97eff7309c74ba269c7bf7814d3a, type: 3}
    name: Tour Guide
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "<SFX_tour_guide_thinking>You sure know your stuff! But the records about the
      other leaders haven\u2019t survived as well, and it was Rommel Lapuz that led
      the Disidensiya soldiers in the end."
    - "Anyways, he never had any kids of his own, but his relatives\u2019 descendants
      all went on to become influential people in Giyala."
    - '<SFX_tour_guide_chuckle>And they all commemorated his contributions to the
      country in their own ways. These were the people you saw portraits of in the
      main museum, too. '
    - The first to do so was <i><b>Governor Luna Lapuz</b></i>, who had a special
      resting place created for Rommel soon after the war.
    - She was known for advocating for civilian rights to firearms.
    - "Although she\u2019s considered controversial now, many Giyalans back in the
      day thought she was a perfect example of someone upholding Rommel\u2019s ideals."
    - The next was a Senator who-
