  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: -1077248894956463413, guid: 4c74d9b45011c0a4cb33179b186c1f73, type: 3}
    character2: {fileID: -1293936391025474623, guid: 4551b9b0ca3f36b498cfea661e9dc542, type: 3}
    name: Anika
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "Some people say the great Se\xF1or Rommel and Se\xF1or Servillano had a big
      misunderstanding that caused them to see each other as enemies in the end. "
    - "It\u2019s easy to believe that because of what happened.\r\n"
