    character2: {fileID: -6412774339020565012, guid: ee489ea9654334b49bebfbb6cef6f549, type: 3}
    name: Tour Guide
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.022
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "Well, you\u2019re the only person I\u2019ve gotten to tell all this in a while.
      It would be a shame if I spent the day telling you lies.\r\n"
    - "Besides, with all the things Sumpagita is going through lately... I\u2019m
      just not in the mood to butter up all these people. "
    - "Anyways, that\u2019s that story done. Is there anything else you want to know?\r\n"
