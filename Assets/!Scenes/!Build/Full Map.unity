    m_TransformParent: {fileID: 5241788476949817006}
    m_Modifications:
    - target: {fileID: 2056137909235263251, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: m_Name
      value: L3 Portrait4
      objectReference: {fileID: 0}
    - target: {fileID: 3714461931801894458, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: id
      value: e3cfd2ca-6edf-45b6-8549-58a6167a9b6a
      objectReference: {fileID: 0}
    - target: {fileID: 4346630092607017282, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: id
      value: 40862d65-35d8-412d-9f86-2fbed1f5c37e
      objectReference: {fileID: 0}
    - target: {fileID: 5061493601044972228, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: id
      value: 61bc5871-61a6-4983-9f82-dfd587e1d8e0
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.name
      value: Santi
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.character
      value: 
      objectReference: {fileID: -4258627021580615586, guid: 7c50abb68975940c9a305e1136732385, type: 3}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: <i>(Out of everyone here, she looks like the only one who followed through
        on her promises. Barely any controversies throughout her political career.
        That I know of, anyways.)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "<i>(But nowadays, people don\u2019t speak highly of her. I guess public
        values have just changed over time.)</i>"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "\u201CNo journey is too treacherous nor a price too big for progress.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5654484641697981369, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: <i>(Big words for someone not present for most of their term. If he
        truly did care, then why is Sumpagita still mostly rundown?)</i>
      objectReference: {fileID: 0}
    - target: {fileID: 5790941259824625341, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: m_text
      value: 'Portrait 4: Governor who was into guns'
      objectReference: {fileID: 0}
    - target: {fileID: 5790941259824625341, guid: 0d0aec03b4a2e4eebac4d306d494957c, type: 3}
      propertyPath: m_fontSize
      value: 0.55
      objectReference: {fileID: 0}
