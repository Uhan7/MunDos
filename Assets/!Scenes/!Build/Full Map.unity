  dialogue:
    character: {fileID: -3929998360153519, guid: 7768e6cd5d1d84ba3b1a2c94654bef5d, type: 3}
    character2: {fileID: 21300000, guid: 96eb344a6948b4d6d9857fbd42887954, type: 3}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 3eb1024c55ce8430ba259a61060f08e3, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - <i>(He appears rather suspicious of me. Was I too forward?)</i>
    - <i>(...Or does he have reason not to trust someone associated with Servillano
      now?)</i>
    - <i>(I need to be more careful.)</i>
