      objectReference: {fileID: 1637154496}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: dialogue.name
      value: Santi
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: dialogue.character
      value: 
      objectReference: {fileID: -4258627021580615586, guid: 7c50abb68975940c9a305e1136732385, type: 3}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: linksToOtherDialogue
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "Magic isn\u2019t the kind of thing people are willing to just talk
        about openly. It\u2019s bad luck, and the government has been hunting magic
        users for a while now."
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "Most people don't even believe that it\u2019s real anymore."
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "This place is secluded and quiet\u2026 and best of all, far from prying
        eyes. It\u2019s the perfect spot to relax on my own."
      objectReference: {fileID: 0}
