    - target: {fileID: 5994212485817288540, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: m_Name
      value: 26
      objectReference: {fileID: 0}
    - target: {fileID: 5994212485817288540, guid: f8e102a253b7a4c509f8ea79c303fd6a, type: 3}
      propertyPath: m_IsActive
      value: 0
