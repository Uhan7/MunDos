      value: 
      objectReference: {fileID: -766158179369566821, guid: 43023e1e55b1c4b969570c5c23126194, type: 3}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: (A bunch of newspaper clippings. Maybe reading through them can give
        me information)
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "(One of the newspapers has a headline in bold, \u2018CWS soldiers taking
        camp in mountainous areas\u2019)"
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "(Another one\u2026 \u2018Traitors in the government?!\u2019)"
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "(An opinion piece\u2026 \u2018Brewing tensions. Are we SAFE?\u2019)"
      objectReference: {fileID: 0}
    - target: {fileID: 9041903786073183966, guid: 09fbf670f6b1442b3895d0264e1b949c, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: (Nothing more interesting)
      objectReference: {fileID: 0}
