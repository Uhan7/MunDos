    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "(This outpost is definitely hiding something, but they\u2019ll get
        suspicious if I stay too long.)"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "I should head back into town to see if anyone else has heard of these
        \u201Cmagic attacks\u201D."
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "This place is secluded and quiet\u2026 and best of all, far from prying
        eyes. It\u2019s the perfect spot to relax on my own."
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
