    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: nextDialogue
      value: 
      objectReference: {fileID: 1357075108}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: dialogue.name
      value: Liezel
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: dialogue.character
      value: 
      objectReference: {fileID: -766158179369566821, guid: 43023e1e55b1c4b969570c5c23126194, type: 3}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: linksToOtherDialogue
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "\u2026 Haha, yes. It would be difficult not to believe in something
        you can plainly see."
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: In any case, I believe I have a lead of my own to follow.
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "(I wanted to focus on finding out the reason for the war but\u2026
        this situation with magic can't be ignored.)"
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: (That this book survived through that is a miracle of itself. I shouldn't
        push our luck.)
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: (I need to find out what happened to make people so wary of magic, or
        else this connection could be lost...)
      objectReference: {fileID: 0}
    - target: {fileID: 8439490232393766861, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[5]'
      value: "I\u2019m going to investigate the rumors circulating here. We should
        also try to find a way to decode those messages. "
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 81384a7b019dc43269dd45a9471e5b47, type: 3}
