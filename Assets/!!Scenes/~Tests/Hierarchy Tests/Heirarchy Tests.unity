  m_Script: {fileID: 11500000, guid: 1a586b723e969462a991b263e7dd4cc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    character: {fileID: -3929998360153519, guid: 7768e6cd5d1d84ba3b1a2c94654bef5d, type: 3}
    character2: {fileID: 3825917228853779581, guid: 715adfd12147dc1479155bff01c07e0a, type: 3}
    name: Liezel
    soundToPlay: {fileID: 8300000, guid: 1cfd43b09479e4b35a0341f36b492e9b, type: 3}
    audioPitchOffset: 0
    font: {fileID: 0}
    textSpeed: 0.024
    textPunctSpeed: 0.18
    lettersUntilSFX: 3
    sentences:
    - "He\u2019s the forefront leader of the Disidensiya."
    - ' ... And, coincidentally, my brother-in-law.'
    - "<i>(It is a pity that his name does not seem to have survived... But then...
      How come the Disidensiya\u2019s has?)</i>"
    - "<i>(Well, I suppose it is possible that Santi just is not knowledgeable on
      the Disidensiya\u2019s history.)</i>"
    - In any case, we might be able to unlock this chest by looking for <b>things
      related to someone named <u>Servillano Solomon</u></b>.
